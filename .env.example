# ---------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------
# Safe to expose: these are the only two values the browser ever sees.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never import into a
# Client Component — this key bypasses Row Level Security entirely.
# Required for admin-created teacher/student accounts, which need the
# Auth Admin API. Everything else works without it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build password-reset and class-invite links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
